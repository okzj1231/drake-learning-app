# Copy to .env.local for `vercel dev`. On Vercel, set these in
# Project Settings → Environment Variables instead. Never commit real values.

# --- Secret: server only, never sent to the browser ---
ANTHROPIC_API_KEY=
# Supabase → Project Settings → API Keys → "secret" key (or the legacy service_role key)
SUPABASE_SECRET_KEY=

# --- Public: sent to the browser by /api/config (protected by row-level security) ---
# Supabase → Project Settings → API → Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=
# Supabase → Project Settings → API Keys → "publishable" key (or the legacy anon key)
SUPABASE_PUBLISHABLE_KEY=

# --- Options ---
# Max chat messages per student per day (UTC). Default: 50
DAILY_MESSAGE_LIMIT=50
# "true" to show "Continue with Google" (enable the Google provider in Supabase first)
AUTH_GOOGLE_ENABLED=false
